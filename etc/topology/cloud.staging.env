# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=staging
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=cloud.staging
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://customer-service-staging.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=staging
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=cloud.staging
