# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_customer_service_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=cloud.demo
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://customer-service-demo.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND=127.0.0.1:4243
SDKWORK_CUSTOMER_SERVICE_PC_INTERNAL_DEV_PORT=4245
SDKWORK_CUSTOMER_SERVICE_H5_INTERNAL_DEV_PORT=4246


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=demo
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=cloud.demo
