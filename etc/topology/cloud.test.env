# Bootstrap profile cloud.test — replace with application-specific values.
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=test
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=cloud.test
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://customer-service-test.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND=127.0.0.1:4243
SDKWORK_CUSTOMER_SERVICE_PC_INTERNAL_DEV_PORT=4245
SDKWORK_CUSTOMER_SERVICE_H5_INTERNAL_DEV_PORT=4246


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=test
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=cloud.test
