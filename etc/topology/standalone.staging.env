# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=staging
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=standalone.staging
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://customer-service-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=staging
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=standalone.staging
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18091
VITE_SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18091
