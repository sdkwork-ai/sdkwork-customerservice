# cloud.development
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=development
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

CUSTOMER_SERVICE_API_BIND=127.0.0.1:18091
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18091
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_CUSTOMERSERVICE_INGRESS_TOKEN=dev-customerservice-ingress-token
CUSTOMER_SERVICE_CREDENTIAL_MASTER_KEY=dev-customerservice-credential-master-key-change-in-production
SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND=127.0.0.1:4243
SDKWORK_CUSTOMER_SERVICE_PC_INTERNAL_DEV_PORT=4245
SDKWORK_CUSTOMER_SERVICE_H5_INTERNAL_DEV_PORT=4246

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=development
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=cloud.development

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
