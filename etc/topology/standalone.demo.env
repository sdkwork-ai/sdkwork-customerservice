# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_customer_service_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CUSTOMER_SERVICE_PROFILE_ID=standalone.demo
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=https://customer-service-demo.sdkwork.com
SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND=127.0.0.1:4243
SDKWORK_CUSTOMER_SERVICE_PC_INTERNAL_DEV_PORT=4245
SDKWORK_CUSTOMER_SERVICE_H5_INTERNAL_DEV_PORT=4246


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CUSTOMER_SERVICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CUSTOMERSERVICE_ENVIRONMENT=demo
SDKWORK_CUSTOMERSERVICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_CUSTOMERSERVICE_PROFILE_ID=standalone.demo
SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18091
VITE_SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18091
SDKWORK_CORS_ALLOWED_ORIGINS=https://customer-service-demo.sdkwork.com,http://customer-service-demo.sdkwork.com,https://customer-service-demo.birdcoder.com,http://customer-service-demo.birdcoder.com,https://customer-service-demo.dtupay.com,http://customer-service-demo.dtupay.com,https://customer-service-demo.noaper.com,http://customer-service-demo.noaper.com,https://customer-service-demo.sdkwork.cn,http://customer-service-demo.sdkwork.cn,https://customer-service-demo.birdcoder.cn,http://customer-service-demo.birdcoder.cn,https://customer-service-demo.dtupay.cn,http://customer-service-demo.dtupay.cn,https://customer-service-demo.noaper.cn,http://customer-service-demo.noaper.cn,https://customer-service-demo.skubc.com,http://customer-service-demo.skubc.com,https://customer-service-demo.skubc.cn,http://customer-service-demo.skubc.cn,https://customer-service-demo.zowalk.com,http://customer-service-demo.zowalk.com,https://customer-service-demo.zowalk.cn,http://customer-service-demo.zowalk.cn,https://customer-service-demo.offer86.com,http://customer-service-demo.offer86.com,https://customer-service-demo.offer86.cn,http://customer-service-demo.offer86.cn,https://customer-service-demo.86offer.com,http://customer-service-demo.86offer.com,https://customer-service-demo.86offer.cn,http://customer-service-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
