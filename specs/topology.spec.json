{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-customerservice",
  "applicationCode": "customer_service",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "gatewayBind": "127.0.0.1:18091",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_CUSTOMER_SERVICE_ENVIRONMENT",
    "profileId": "SDKWORK_CUSTOMER_SERVICE_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_CUSTOMER_SERVICE_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_INGRESS_BIND",
    "apiGatewayBaseUrl": "SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CUSTOMER_SERVICE_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CUSTOMER_SERVICE_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "components": {
    "applicationServer": {
      "crate": "sdkwork-api-customerservice-standalone-gateway",
      "binary": "customerservice-server"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "customerservice-api",
            "crate": "sdkwork-api-customerservice-standalone-gateway",
            "binary": "customerservice-server",
            "role": "api-standalone-gateway"
          },
          {
            "id": "customerservice-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-customerservice-pc",
            "bindEnv": "SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "browserDeliveries": [
          {
            "id": "customerservice-adaptive-web",
            "applicationRoot": "apps/sdkwork-customerservice-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "customerservice-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-customerservice-pc",
                "script": "dev",
                "defaultPort": 4245,
                "portEnv": "SDKWORK_CUSTOMER_SERVICE_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-customerservice-h5",
                "script": "dev",
                "defaultPort": 4246,
                "portEnv": "SDKWORK_CUSTOMER_SERVICE_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ],
        "healthSurfaces": []
      },
      "standalone.production": {
        "processes": [
          {
            "id": "customerservice-api",
            "crate": "sdkwork-api-customerservice-standalone-gateway",
            "binary": "customerservice-server",
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [],
        "browserDeliveries": [
          {
            "id": "customerservice-static-v1",
            "applicationRoot": "apps/sdkwork-customerservice-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "customerservice-api",
            "buildOutput": "apps/sdkwork-customerservice-pc/dist",
            "runtimeRootEnv": "SDKWORK_CUSTOMERSERVICE_PC_STATIC_ROOT",
            "mountPath": "/",
            "spaFallback": "/index.html"
          }
        ]
      },
      "cloud.development": {
        "processes": [
          {
            "id": "customerservice-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-customerservice-pc",
            "bindEnv": "SDKWORK_CUSTOMER_SERVICE_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
